{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/components/*": [
        "../../components/*",
        "./components/*"
      ],
      "@/lib/*": [
        "../../lib/*",
        "./lib/*"
      ],
      "@/hooks/*": [
        "../../hooks/*",
        "./hooks/*"
      ],
      "@/types/*": [
        "../../types/*",
        "./types/*"
      ],
      "@/styles/*": [
        "../../styles/*",
        "./styles/*"
      ],
      "@/packages/*": [
        "../../packages/*"
      ],
      "@/*": [
        "./*",
        "../../*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../components/**/*.ts",
    "../../components/**/*.tsx",
    "../../lib/**/*.ts",
    "../../lib/**/*.tsx",
    "../../hooks/**/*.ts",
    "../../hooks/**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
