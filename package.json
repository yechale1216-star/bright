{
  "name": "bright-path",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbo",
    "dev:stable": "next dev --webpack",
    "dev:school": "next dev apps/school-portal -p 3000 --webpack",
    "dev:school:turbo": "next dev apps/school-portal -p 3000 --turbo",
    "dev:portal": "next dev apps/student-parent-portal -p 3001 --webpack",
    "dev:portal:turbo": "next dev apps/student-parent-portal -p 3001 --turbo",
    "build": "next build --webpack",
    "build:school": "next build apps/school-portal --webpack",
    "build:portal": "next build apps/student-parent-portal --webpack",
    "start:school": "next start apps/school-portal -p 3000",
    "start:portal": "next start apps/student-parent-portal -p 3001",
    "build:android": "node scripts/capacitor-build.js && npx cap sync android",
    "build:apk:school": "node scripts/build-apk.js --target=school",
    "build:apk:portal": "node scripts/build-apk.js --target=portal",
    "build:apk:all": "node scripts/build-apk.js --all",
    "dev:server": "npm --prefix server run dev",
    "fix": "powershell ./scripts/fix-turbo.ps1",
    "clean-dev": "powershell ./scripts/fix-turbo.ps1 && npm run dev",
    "mobile": "powershell -ExecutionPolicy Bypass -File ./scripts/mobile-dev.ps1",
    "mobile:forward": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:5000 tcp:5000",
    "lint": "next lint",
    "start": "next start",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-badge": "^8.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "1.0.2",
    "@radix-ui/react-accordion": "1.2.13",
    "@radix-ui/react-alert-dialog": "1.1.16",
    "@radix-ui/react-aspect-ratio": "1.1.9",
    "@radix-ui/react-avatar": "1.1.12",
    "@radix-ui/react-checkbox": "1.3.4",
    "@radix-ui/react-collapsible": "1.1.13",
    "@radix-ui/react-context-menu": "2.3.0",
    "@radix-ui/react-dialog": "1.1.16",
    "@radix-ui/react-dropdown-menu": "2.1.17",
    "@radix-ui/react-hover-card": "1.1.16",
    "@radix-ui/react-label": "2.1.9",
    "@radix-ui/react-menubar": "1.1.17",
    "@radix-ui/react-navigation-menu": "1.2.15",
    "@radix-ui/react-popover": "1.1.16",
    "@radix-ui/react-progress": "1.1.9",
    "@radix-ui/react-radio-group": "1.4.0",
    "@radix-ui/react-scroll-area": "1.2.11",
    "@radix-ui/react-select": "2.3.0",
    "@radix-ui/react-separator": "1.1.9",
    "@radix-ui/react-slider": "1.4.0",
    "@radix-ui/react-slot": "1.2.5",
    "@radix-ui/react-switch": "1.3.0",
    "@radix-ui/react-tabs": "1.1.14",
    "@radix-ui/react-toast": "1.2.16",
    "@radix-ui/react-toggle": "1.1.11",
    "@radix-ui/react-toggle-group": "1.1.12",
    "@radix-ui/react-tooltip": "1.2.9",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.89.0",
    "@types/leaflet": "^1.9.22",
    "@upstash/ratelimit": "2.0.7",
    "@upstash/redis": "1.36.0",
    "@vercel/analytics": "1.3.1",
    "@vladmandic/face-api": "^1.7.15",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "firebase": "^12.15.0",
    "framer-motion": "^12.40.0",
    "geist": "^1.3.1",
    "input-otp": "1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "nanoid": "^3.3.6",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "node-fetch": "3.3.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "2.15.4",
    "socket.io-client": "^4.8.3",
    "sonner": "2.0.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "null-loader": "^4.0.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "ts-jest": "^29.4.11",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  }
}
