generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id                   String                  @id @default(uuid())
  schoolId             String?                 @unique
  name                 String
  schoolEmail          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  attendance           Attendance[]
  callHistories        CallHistory[]
  callParticipants     CallParticipant[]
  callSessions         CallSession[]
  conversations        Conversation[]
  grades               Grade[]
  messages             Message[]
  messageReactions     MessageReaction[]
  messageReads         MessageRead[]
  parentNotifications  ParentNotification[]
  parentStudentLinks   ParentStudentLink[]
  pendingRegistrations PendingRegistration[]
  settings             SchoolSettings?
  sections             Section[]
  streams              Stream[]
  students             Student[]
  promotions           StudentPromotion[]
  teachers             Teacher[]
  assignments          TeacherAssignment[]
  users                User[]
  reports              AttendanceReport[]
  auditLogs            AuditLog[]
  supportTickets       SupportTicket[]
  userNotifications    UserNotification[]
  disciplines          StudentDiscipline[]
  disciplineCategories DisciplineCategory[]
  disciplineActions    DisciplineActionConfig[]
  systemRoles          SystemRole[]
  academicYears        AcademicYear[]
  academicTerms        AcademicTerm[]
  subjects             Subject[]
  classrooms           Classroom[]
  timetables           Timetable[]
  timetablePeriods     TimetablePeriod[]
  timetableSlots       TimetableSlot[]
  attendanceEditRequests AttendanceEditRequest[]
}

model User {
  id                         String               @id @default(uuid())
  email                      String               @unique
  password_hash              String
  full_name                  String
  role                       String
  phone                      String?              @unique
  is_active                  Boolean              @default(true)
  teacher_id                 String?
  schoolId                   String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  experience_years           Int?
  qualification              String?
  subject                    String?
  profile_photo              String?
  is_verified                Boolean              @default(false)
  verification_token         String?
  verification_token_expires DateTime?
  reset_password_expires     DateTime?
  reset_password_token       String?              @unique
  address                    String?
  lastActive                 DateTime?
  pushToken                  String?
  callHistory                CallHistory[]
  callSessions               CallParticipant[]
  conversations              ConversationMember[]
  messages                   Message[]
  messageReactions           MessageReaction[]
  messageReads               MessageRead[]
  parentStudents             ParentStudentLink[]
  school                     School?              @relation(fields: [schoolId], references: [id])
  notifications              UserNotification[]
  reportedDisciplines        StudentDiscipline[]  @relation("ReportedBy")
  assignedDisciplines        StudentDiscipline[]  @relation("AssignedOfficer")
  disciplineFollowUps        DisciplineFollowUp[]
  createdTimetables          Timetable[]
  savedBookmarks             SavedBookmark[]

  @@index([email])
  @@index([schoolId])
}

model Teacher {
  id               String              @id @default(uuid())
  name             String
  email            String?             @unique
  schoolId         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  experience_years Int?
  is_active        Boolean             @default(true)
  phone            String?
  qualification    String?
  subject          String?
  user_id          String?             @unique
  profile_photo    String?
  attendance       Attendance[]
  school           School?             @relation(fields: [schoolId], references: [id])
  assignments      TeacherAssignment[]
  timetableSlots   TimetableSlot[]     @relation("AssignedTeacher")
  substituteSlots  TimetableSlot[]     @relation("SubstituteTeacher")
  attendanceEditRequests AttendanceEditRequest[]

  @@index([schoolId])
}

model TeacherAssignment {
  id         String   @id @default(uuid())
  teacher_id String
  schoolId   String?
  gradeId    String
  sectionId  String
  subject    String?
  streamId   String?
  createdAt  DateTime @default(now())
  grade      Grade    @relation(fields: [gradeId], references: [id])
  school     School?  @relation(fields: [schoolId], references: [id])
  section    Section  @relation(fields: [sectionId], references: [id])
  stream     Stream?  @relation(fields: [streamId], references: [id])
  teacher    Teacher  @relation(fields: [teacher_id], references: [id])

  @@index([schoolId])
  @@index([teacher_id])
  @@index([gradeId])
  @@index([sectionId])
  @@index([streamId])
}

model SchoolSettings {
  id                   String   @id @default(uuid())
  schoolId             String?  @unique
  school_name          String?
  school_phone         String?
  school_address       String?
  academic_year        String?
  attendance_mode      String   @default("session_based")
  attendance_ui_type   String   @default("card_based")
  attendance_threshold Int      @default(75)
  allow_late_mark      Boolean  @default(true)
  email_notifications      Boolean  @default(true)
  sms_notifications        Boolean  @default(false)
  notification_time        String   @default("16:00")
  allow_attendance_editing Boolean  @default(true)
  restrict_location         Boolean  @default(false)
  school_latitude           Float?
  school_longitude          Float?
  allowed_radius_meters     Int      @default(200)
  allow_outside_attendance  Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt            DateTime @updatedAt
  school_logo          String?
  school               School?  @relation(fields: [schoolId], references: [id])
}

model Grade {
  id             String              @id @default(uuid())
  schoolId       String?
  name           String
  school         School?             @relation(fields: [schoolId], references: [id])
  students       Student[]
  fromPromotions StudentPromotion[]  @relation("FromGrade")
  toPromotions   StudentPromotion[]  @relation("ToGrade")
  assignments    TeacherAssignment[]
  disciplines    StudentDiscipline[]
  timetables     Timetable[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id             String              @id @default(uuid())
  schoolId       String?
  name           String
  school         School?             @relation(fields: [schoolId], references: [id])
  students       Student[]
  fromPromotions StudentPromotion[]  @relation("FromSection")
  toPromotions   StudentPromotion[]  @relation("ToSection")
  assignments    TeacherAssignment[]
  disciplines    StudentDiscipline[]
  timetables     Timetable[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Stream {
  id             String              @id @default(uuid())
  schoolId       String?
  name           String
  school         School?             @relation(fields: [schoolId], references: [id])
  students       Student[]
  fromPromotions StudentPromotion[]  @relation("FromStream")
  toPromotions   StudentPromotion[]  @relation("ToStream")
  assignments    TeacherAssignment[]
  disciplines    StudentDiscipline[]
  timetables     Timetable[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Student {
  id                  String               @id @default(uuid())
  student_id          String
  parent_email        String
  parent_phone        String
  parent_name         String
  gender              String?
  date_of_birth       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  fullName            String
  status              String               @default("ACTIVE")
  gradeId             String
  schoolId            String?
  sectionId           String
  streamId            String?
  address             String?
  attendance          Attendance[]
  parentNotifications ParentNotification[]
  parentStudents      ParentStudentLink[]
  disciplines         StudentDiscipline[]
  grade               Grade                @relation(fields: [gradeId], references: [id])
  school              School?              @relation(fields: [schoolId], references: [id])
  section             Section              @relation(fields: [sectionId], references: [id])
  stream              Stream?              @relation(fields: [streamId], references: [id])
  promotions          StudentPromotion[]
  attendanceEditRequests AttendanceEditRequest[]

  @@unique([student_id, schoolId])
  @@index([schoolId])
  @@index([gradeId])
  @@index([sectionId])
  @@index([streamId])
}

model StudentPromotion {
  id               String   @id @default(uuid())
  schoolId         String
  studentId        String
  academicYear     String
  fromGradeId      String
  fromSectionId    String
  toGradeId        String?
  toSectionId      String?
  fromStreamId     String?
  toStreamId       String?
  promotedByUserId String
  promotedAt       DateTime @default(now())
  notes            String?
  fromGrade        Grade    @relation("FromGrade", fields: [fromGradeId], references: [id])
  fromSection      Section  @relation("FromSection", fields: [fromSectionId], references: [id])
  fromStream       Stream?  @relation("FromStream", fields: [fromStreamId], references: [id])
  school           School   @relation(fields: [schoolId], references: [id])
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  toGrade          Grade?   @relation("ToGrade", fields: [toGradeId], references: [id])
  toSection        Section? @relation("ToSection", fields: [toSectionId], references: [id])
  toStream         Stream?  @relation("ToStream", fields: [toStreamId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([fromGradeId])
  @@index([toGradeId])
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  date      DateTime @default(now())
  status    String
  session   String?
  remarks          String?
  latitude         Float?
  longitude        Float?
  locationVerified Boolean? @default(false)
  locationDistance Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  schoolId         String?
  teacherId        String?
  school           School?  @relation(fields: [schoolId], references: [id])
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher          Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([schoolId])
  @@index([date])
  @@index([session])
  @@index([status])
  @@index([schoolId, date])
  @@index([schoolId, date, status])
  @@index([schoolId, teacherId, date])
}

model AttendanceEditRequest {
  id               String    @id @default(uuid())
  schoolId         String
  teacherId        String
  studentId        String?
  gradeId          String?
  sectionId        String?
  date             DateTime
  session          String?
  reason           String?
  status           String    @default("PENDING")
  adminNote        String?
  processedBy      String?
  processedAt      DateTime?
  isUsed           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher          Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student          Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([teacherId])
  @@index([status])
  @@index([date])
  @@map("attendance_edit_requests")
}

model AuditLog {
  id          String   @id @default(uuid())
  schoolId    String?
  user_id     String?
  action      String
  entity_type String
  entity_id   String?
  old_values  Json?
  new_values  Json?
  created_at  DateTime @default(now())
  school      School?  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("audit_logs")
}

model AttendanceReport {
  id                    String   @id @default(uuid())
  schoolId              String?
  student_id            String
  class_id              String
  month                 Int
  year                  Int
  total_days            Int      @default(0)
  present_days          Int      @default(0)
  absent_days           Int      @default(0)
  late_days             Int      @default(0)
  leave_days            Int      @default(0)
  attendance_percentage Decimal  @default(0.00) @db.Decimal(5, 2)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  school                School?  @relation(fields: [schoolId], references: [id])

  @@unique([student_id, month, year])
  @@index([schoolId])
  @@map("attendance_reports")
}

model ParentStudentLink {
  id               String   @id @default(uuid())
  schoolId         String?
  parentId         String
  studentId        String
  relationshipType String?  @default("Guardian")
  createdAt        DateTime @default(now())
  parent           User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school           School?  @relation(fields: [schoolId], references: [id])
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([schoolId])
}

model ParentNotification {
  id         String   @id @default(uuid())
  schoolId   String?
  studentId  String?
  type       String   // absent, late, announcement, emergency, warning
  category   String   @default("GENERAL") // ATTENDANCE, DISCIPLINE, ACADEMIC, ANNOUNCEMENT, SYSTEM
  priority   String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  title      String
  message    String
  targetRole String?  // ALL_PARENTS, SPECIFIC_GRADE, etc.
  metadata   String?  // JSON stringified payload / deep links
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  school     School?  @relation(fields: [schoolId], references: [id])
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, createdAt])
}

model ParentPreferences {
  id                 String   @id @default(uuid())
  parentPhone        String
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  pushNotifications  Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  schoolId           String?

  @@unique([parentPhone, schoolId])
}

model Conversation {
  id                String               @id @default(uuid())
  name              String?
  isGroup           Boolean              @default(false)
  avatar            String?
  description       String?
  groupType         String?              // GRADE | PARENT | TEACHER | STAFF | ANNOUNCEMENT | CUSTOM
  isAnnouncement    Boolean              @default(false)
  isSavedMessages   Boolean              @default(false)
  savedMessagesFor  String?              // userId of the owner
  createdBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  schoolId          String?
  school            School?              @relation(fields: [schoolId], references: [id])
  members           ConversationMember[]
  messages          Message[]
  pinnedMessages    PinnedMessage[]
  savedBookmarks    SavedBookmark[]

  @@unique([savedMessagesFor, schoolId])
  @@index([schoolId])
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  isMuted        Boolean      @default(false)
  mutedUntil     DateTime?
  lastSeenAt     DateTime?
  nickname       String?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@index([userId, conversationId])     // presence scoping: find all convs for a user
}

model Message {
  id               String            @id @default(uuid())
  schoolId         String?
  conversationId   String
  senderId         String
  content          String?
  type             String            @default("TEXT")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  editedAt         DateTime?
  isDeleted        Boolean           @default(false)
  replyToId        String?
  forwardedFromId  String?
  attachments      Json?
  metadata         Json?
  conversation     Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo          Message?          @relation("Replies", fields: [replyToId], references: [id])
  replies          Message[]         @relation("Replies")
  school           School?           @relation(fields: [schoolId], references: [id])
  sender           User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions        MessageReaction[]
  readBy           MessageRead[]
  pinnedIn         PinnedMessage[]
  savedBookmarks   SavedBookmark[]

  @@index([conversationId])
  @@index([conversationId, createdAt])   // message pagination — avoids full-table sort
  @@index([conversationId, createdAt, id]) // composite index for cursor-based pagination
  @@index([schoolId, conversationId])    // tenant-scoped conversation message fetch
  @@index([senderId])
  @@index([createdAt])
  @@index([schoolId])
}

model PinnedMessage {
  id             String       @id @default(uuid())
  conversationId String
  messageId      String
  pinnedBy       String
  pinnedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
  @@index([conversationId])
}

model SavedBookmark {
  id             String       @id @default(uuid())
  userId         String
  messageId      String
  conversationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, conversationId])
  @@index([userId])
  @@map("saved_bookmarks")
}

model MessageRead {
  id        String   @id @default(uuid())
  schoolId  String?
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  school    School?  @relation(fields: [schoolId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@index([schoolId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  schoolId  String?
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  school    School?  @relation(fields: [schoolId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@index([schoolId])
}

model CallSession {
  id               String            @id @default(uuid())
  callId           String?           @unique // signaling callId from client
  schoolId         String?
  conversationId   String?
  type             String            @default("VOICE")
  status           String            @default("ONGOING")
  startTime        DateTime          @default(now())
  answerTime       DateTime?
  endTime          DateTime?
  duration         Int?              // seconds, filled on end
  disconnectReason String?           // ENDED | CANCELLED | MISSED | DECLINED | FAILED | BUSY
  networkQuality   String?           // GOOD | POOR | BAD (from initiator stats)
  createdAt        DateTime          @default(now())
  history          CallHistory[]
  participants     CallParticipant[]
  school           School?           @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([callId])
}

model CallParticipant {
  id            String      @id @default(uuid())
  schoolId      String?
  callSessionId String
  userId        String
  joinedAt      DateTime    @default(now())
  leftAt        DateTime?
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  school        School?     @relation(fields: [schoolId], references: [id])
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callSessionId, userId])
  @@index([schoolId])
}

model CallHistory {
  id               String      @id @default(uuid())
  schoolId         String?
  callId           String?     // matches CallSession.callId
  userId           String      // caller
  recipientId      String?     // callee
  callSessionId    String
  type             String
  status           String
  duration         Int?
  answerTime       DateTime?
  endTime          DateTime?
  disconnectReason String?
  createdAt        DateTime    @default(now())
  callSession      CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  school           School?     @relation(fields: [schoolId], references: [id])
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([callId])
}

model PendingRegistration {
  id            String   @id
  schoolId      String?
  email         String   @unique
  password_hash String
  full_name     String
  role          String
  phone         String?
  school_name   String?
  token         String   @unique
  expires_at    DateTime
  createdAt     DateTime @default(now())
  school        School?  @relation(fields: [schoolId], references: [id])

  @@index([email])
  @@index([token])
  @@index([schoolId])
}

model PlatformConfig {
  id               String   @id @default("singleton")
  platformName     String   @default("Zetime")
  supportEmail     String   @default("support@zetime.io")
  maintenanceMode  Boolean  @default(false)
  autoBackup       Boolean  @default(true)
  apiRateLimit     Int      @default(1000)
  maxUploadSize    Int      @default(50)
  trialEnabled     Boolean  @default(true)
  trialDuration    Int      @default(14)
  trialCapacity    Int      @default(100)
  updatedAt        DateTime @updatedAt
  maxLoginAttempts Int      @default(5)
  sessionTimeout   Int      @default(30)
  twoFactorEnabled Boolean  @default(false)

  @@map("platform_configs")
}

model SupportTicket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique
  schoolId     String
  authorId     String?
  subject      String
  description  String
  category     String   @default("General")
  status       String   @default("open")
  priority     String   @default("normal")
  assignee     String?
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@map("support_tickets")
}

model BroadcastLog {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   @default("info")
  sentCount Int      @default(0)
  sentAt    DateTime @default(now())

  @@map("broadcast_logs")
}

model SystemRole {
  id          String   @id @default(uuid())
  schoolId    String?
  key         String
  name        String
  description String?
  color       String   @default("#6366f1")
  isSystem    Boolean  @default(true)
  isActive    Boolean  @default(true)
  permissions Json     @default("{}")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([key])
  @@map("system_roles")
}



model UserNotification {
  id         String   @id @default(uuid())
  schoolId   String?
  userId     String
  type       String   // INFO, WARNING, ALERT, MESSAGE, SYSTEM
  category   String   @default("GENERAL") // ATTENDANCE, DISCIPLINE, ACADEMIC, ANNOUNCEMENT, SYSTEM, MESSAGE
  priority   String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  title      String
  message    String
  targetRole String?  // ALL_TEACHERS, SCHOOL_ADMINS, etc.
  metadata   String?  // JSON stringified payload
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  school     School?  @relation(fields: [schoolId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([schoolId, createdAt])
}

model DisciplineCategory {
  id          String              @id @default(uuid())
  schoolId    String?
  name        String
  description String?
  isDefault   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  school      School?             @relation(fields: [schoolId], references: [id])
  disciplines StudentDiscipline[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("discipline_categories")
}

model StudentDiscipline {
  id                        String               @id @default(uuid())
  caseNumber                String?
  schoolId                  String
  studentId                 String
  gradeId                   String
  sectionId                 String
  streamId                  String?
  date                      DateTime             @default(now())
  time                      String?
  categoryId                String?
  categoryName              String
  severity                  String               @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  title                     String
  description               String
  location                  String?
  reportedById              String?
  reportedByName            String?
  assignedToId              String?
  assignedToName            String?
  witnesses                 Json?
  evidence                  Json?                // Array of { url, name, type, size }
  immediateAction           String?
  investigationNotes        String?
  findings                  String?
  meetingNotes              String?
  recommendedAction         String?
  approvedAction            String?
  actionDate                DateTime?
  responsibleStaffName      String?
  actionStatus              String?              @default("PENDING") // PENDING, APPROVED, IN_PROGRESS, COMPLETED
  confidentialNotes         String?
  parentNotified            Boolean              @default(false)
  parentNotifiedAt          DateTime?
  parentAcknowledged        Boolean              @default(false)
  parentAcknowledgedAt      DateTime?
  parentAcknowledgementNotes String?
  followUpDate              DateTime?
  resolutionNotes           String?
  status                    String               @default("OPEN") // OPEN, UNDER_REVIEW, INVESTIGATION, ACTION_REQUIRED, RESOLVED, CLOSED
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  school                    School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student                   Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade                     Grade                @relation(fields: [gradeId], references: [id])
  section                   Section              @relation(fields: [sectionId], references: [id])
  stream                    Stream?              @relation(fields: [streamId], references: [id])
  reportedBy                User?                @relation("ReportedBy", fields: [reportedById], references: [id])
  assignedTo                User?                @relation("AssignedOfficer", fields: [assignedToId], references: [id])
  category                  DisciplineCategory?  @relation(fields: [categoryId], references: [id])
  followUps                 DisciplineFollowUp[]

  @@index([schoolId])
  @@index([studentId])
  @@index([gradeId])
  @@index([sectionId])
  @@index([status])
  @@index([severity])
  @@index([date])
  @@index([caseNumber])
  @@index([assignedToId])
  @@map("student_disciplines")
}

model DisciplineActionConfig {
  id          String   @id @default(uuid())
  schoolId    String?
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("discipline_action_configs")
}

model DisciplineFollowUp {
  id           String            @id @default(uuid())
  disciplineId String
  authorId     String?
  authorName   String?
  note         String
  actionTaken  String?
  statusBefore String?
  statusAfter  String?
  createdAt    DateTime          @default(now())

  discipline   StudentDiscipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  author       User?             @relation(fields: [authorId], references: [id])

  @@index([disciplineId])
  @@map("discipline_followups")
}

model AcademicYear {
  id          String         @id @default(uuid())
  schoolId    String
  name        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms       AcademicTerm[]
  timetables  Timetable[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model AcademicTerm {
  id             String       @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  timetables     Timetable[]

  @@unique([academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@map("academic_terms")
}

model Subject {
  id          String          @id @default(uuid())
  schoolId    String
  name        String
  code        String
  department  String?
  color       String          @default("#3b82f6")
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slots       TimetableSlot[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

model Classroom {
  id        String          @id @default(uuid())
  schoolId  String
  name      String
  code      String?
  building  String?
  floor     String?
  capacity  Int             @default(40)
  type      String          @default("STANDARD")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slots     TimetableSlot[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classrooms")
}

model Timetable {
  id                 String          @id @default(uuid())
  schoolId           String
  title              String
  academicYearId     String?
  termId             String?
  gradeId            String
  streamId           String?
  sectionId          String?
  status             String          @default("DRAFT")
  version            Int             @default(1)
  effectiveStartDate DateTime?
  effectiveEndDate   DateTime?
  createdById        String?
  publishedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  term         AcademicTerm? @relation(fields: [termId], references: [id])
  grade        Grade         @relation(fields: [gradeId], references: [id])
  stream       Stream?       @relation(fields: [streamId], references: [id])
  section      Section?      @relation(fields: [sectionId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])
  slots        TimetableSlot[]

  @@index([schoolId])
  @@index([gradeId])
  @@index([sectionId])
  @@index([status])
  @@map("timetables")
}

model TimetablePeriod {
  id           String          @id @default(uuid())
  schoolId     String
  name         String
  periodNumber Int
  startTime    String
  endTime      String
  isBreak      Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slots        TimetableSlot[]

  @@unique([schoolId, periodNumber])
  @@index([schoolId])
  @@map("timetable_periods")
}

model TimetableSlot {
  id                  String           @id @default(uuid())
  timetableId         String
  schoolId            String
  dayOfWeek           String
  periodId            String?
  periodNumber        Int
  startTime           String
  endTime             String
  subjectId           String
  teacherId           String?
  classroomId         String?
  gradeId             String
  sectionId           String
  streamId            String?
  notes               String?
  isCancelled         Boolean          @default(false)
  substituteTeacherId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  timetable         Timetable        @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  period            TimetablePeriod? @relation(fields: [periodId], references: [id])
  subject           Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher           Teacher?         @relation("AssignedTeacher", fields: [teacherId], references: [id])
  substituteTeacher Teacher?         @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  classroom         Classroom?       @relation(fields: [classroomId], references: [id])
  grade             Grade            @relation(fields: [gradeId], references: [id])
  section           Section          @relation(fields: [sectionId], references: [id])
  stream            Stream?          @relation(fields: [streamId], references: [id])

  @@index([timetableId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classroomId])
  @@index([dayOfWeek, periodNumber])
  @@index([gradeId, sectionId])
  @@map("timetable_slots")
}





