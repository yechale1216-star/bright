generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String               @id @default(uuid())
  email                      String               @unique
  password_hash              String
  full_name                  String
  role                       String
  phone                      String?              @unique
  is_active                  Boolean              @default(true)
  teacher_id                 String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  experience_years           Int?
  qualification              String?
  subject                    String?
  profile_photo              String?
  is_verified                Boolean              @default(false)
  verification_token         String?
  verification_token_expires DateTime?
  reset_password_expires     DateTime?
  reset_password_token       String?              @unique
  address                    String?
  lastActive                 DateTime?
  pushToken                  String?
  callHistory                CallHistory[]
  callSessions               CallParticipant[]
  conversations              ConversationMember[]
  messages                   Message[]
  messageReactions           MessageReaction[]
  messageReads               MessageRead[]
  parentStudents             ParentStudentLink[]
  notifications              UserNotification[]
  reportedDisciplines        StudentDiscipline[]  @relation("ReportedBy")
  assignedDisciplines        StudentDiscipline[]  @relation("AssignedOfficer")
  disciplineFollowUps        DisciplineFollowUp[]
  createdTimetables          Timetable[]
  savedBookmarks             SavedBookmark[]
  blockedUsers               UserBlock[]          @relation("Blocker")
  blockedBy                  UserBlock[]          @relation("Blocked")
  attendanceMode             String?              @default("DAILY")
  staffAttendance            StaffAttendance[]
  faceEnrollment             StaffFaceEnrollment? @relation("FaceEnrollmentUser")
  enrolledFaces              StaffFaceEnrollment[] @relation("FaceEnrollmentAdmin")
  faceAttempts               StaffFaceAttempt[]
  student                    Student?
  borrowedBooks              BookBorrowRecord[]

  @@index([email])
}

model Teacher {
  id               String              @id @default(uuid())
  name             String
  email            String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  experience_years Int?
  is_active        Boolean             @default(true)
  phone            String?
  qualification    String?
  subject          String?
  user_id          String?             @unique
  profile_photo    String?
  attendance       Attendance[]
  assignments      TeacherAssignment[]
  timetableSlots   TimetableSlot[]     @relation("AssignedTeacher")
  substituteSlots  TimetableSlot[]     @relation("SubstituteTeacher")
  attendanceEditRequests AttendanceEditRequest[]
  homeworksCreated       Assignment[]
  assessmentsCreated     Assessment[]
  assessmentSubmissions  AssessmentSubmissionRecord[]
}

model TeacherAssignment {
  id             String        @id @default(uuid())
  teacher_id     String
  academicYearId String?
  gradeId        String
  sectionId      String
  subjectId      String?
  subject        String?
  streamId       String?
  role           String        @default("SUBJECT_TEACHER") // "SUBJECT_TEACHER" | "HOMEROOM_TEACHER"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  grade          Grade         @relation(fields: [gradeId], references: [id])
  section        Section       @relation(fields: [sectionId], references: [id])
  stream         Stream?       @relation(fields: [streamId], references: [id])
  subjectRef     Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher        Teacher       @relation(fields: [teacher_id], references: [id])

  @@index([teacher_id])
  @@index([gradeId])
  @@index([sectionId])
  @@index([streamId])
  @@index([academicYearId])
  @@index([subjectId])
  @@index([role])
}

model SchoolSettings {
  id                                    String   @id @default("singleton")
  school_name                           String?  @default("Bright Path")
  school_phone                          String?
  school_address                        String?
  academic_year                         String?
  attendance_mode                       String   @default("session_based")
  attendance_ui_type                    String   @default("card_based")
  attendance_threshold                  Int      @default(75)
  allow_late_mark                       Boolean  @default(true)
  email_notifications                   Boolean  @default(true)
  sms_notifications                     Boolean  @default(false)
  notification_time                     String   @default("16:00")
  allow_attendance_editing              Boolean  @default(true)
  restrict_location                     Boolean  @default(false)
  school_latitude                       Float?
  school_longitude                      Float?
  allowed_radius_meters                 Int      @default(200)
  allow_outside_attendance             Boolean  @default(true)
  calendar_type                         String   @default("ETHIOPIAN")
  staff_attendance_mode                 String   @default("daily")
  attendanceModeSetting                 String?  @default("DAILY")
  staff_sessions                        Json?
  staff_working_days                    String   @default("MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY")
  staff_work_start_time                 String?  @default("08:00")
  staff_work_end_time                   String?  @default("17:00")
  staff_late_grace_minutes              Int      @default(15)
  staff_early_checkout_tolerance_minutes Int     @default(15)
  staff_absence_cutoff_minutes          Int      @default(120)
  staff_absence_cutoff_time             String?  @default("10:00")
  staff_earliest_checkin_time           String?  @default("06:00")
  staff_latest_checkout_time            String?  @default("20:00")
  staff_checkin_start                   String?
  staff_checkin_late                    String?
  staff_checkout_early                  String?
  staff_face_required                   Boolean  @default(true)
  staff_geo_required                    Boolean  @default(true)
  allow_staff_checkin_after_cutoff      Boolean  @default(false)
  grade_system                          String   @default("standard")
  email_api_key                         String?
  email_from_domain                     String?  @default("smartattenadacetracker.app")
  createdAt                             DateTime @default(now())
  updatedAt                             DateTime @updatedAt
  school_logo                           String?
}

model SchoolHoliday {
  id          String   @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  type        String   @default("PUBLIC_HOLIDAY")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([isActive])
  @@map("school_holidays")
}

model Grade {
  id                         String                      @id @default(uuid())
  name                       String                      @unique
  students                   Student[]
  studentAcademicYearRecords StudentAcademicYearRecord[]
  fromPromotions             StudentPromotion[]          @relation("FromGrade")
  toPromotions               StudentPromotion[]          @relation("ToGrade")
  assignments                TeacherAssignment[]
  disciplines                StudentDiscipline[]
  timetables                 Timetable[]
  timetableSlots             TimetableSlot[]
  assessments                Assessment[]
  reportCards                ReportCard[]
  homeworkTasks              Assignment[]
  learningMaterials          LearningMaterial[]
  assessmentSchemeAssignments AssessmentSchemeAssignment[]
  assessmentSubmissions      AssessmentSubmissionRecord[]
}

model Section {
  id                         String                      @id @default(uuid())
  name                       String                      @unique
  students                   Student[]
  studentAcademicYearRecords StudentAcademicYearRecord[]
  fromPromotions             StudentPromotion[]          @relation("FromSection")
  toPromotions               StudentPromotion[]          @relation("ToSection")
  assignments                TeacherAssignment[]
  disciplines                StudentDiscipline[]
  timetables                 Timetable[]
  timetableSlots             TimetableSlot[]
  assessments                Assessment[]
  reportCards                ReportCard[]
  homeworkTasks              Assignment[]
  assessmentSubmissions      AssessmentSubmissionRecord[]
}

model Stream {
  id                         String                      @id @default(uuid())
  name                       String                      @unique
  students                   Student[]
  studentAcademicYearRecords StudentAcademicYearRecord[]
  fromPromotions             StudentPromotion[]          @relation("FromStream")
  toPromotions               StudentPromotion[]          @relation("ToStream")
  assignments                TeacherAssignment[]
  disciplines                StudentDiscipline[]
  timetables                 Timetable[]
  timetableSlots             TimetableSlot[]
  assessments                Assessment[]
  assessmentSchemeAssignments AssessmentSchemeAssignment[]
}

model Student {
  id                     String                      @id @default(uuid())
  student_id             String                      @unique
  parent_email           String
  parent_phone           String
  parent_name            String
  gender                 String?
  date_of_birth          String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  fullName               String
  status                 String                      @default("ACTIVE")
  gradeId                String
  sectionId              String
  streamId               String?
  address                String?
  attendance             Attendance[]
  parentNotifications    ParentNotification[]
  parentStudents         ParentStudentLink[]
  disciplines            StudentDiscipline[]
  grade                  Grade                       @relation(fields: [gradeId], references: [id])
  section                Section                     @relation(fields: [sectionId], references: [id])
  stream                 Stream?                     @relation(fields: [streamId], references: [id])
  promotions             StudentPromotion[]
  academicRecords        StudentAcademicYearRecord[]
  attendanceEditRequests AttendanceEditRequest[]
  marks                  StudentMark[]
  reportCards            ReportCard[]
  user_id                String?                     @unique
  user                   User?                       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  submissions            AssignmentSubmission[]
  borrowedBooks          BookBorrowRecord[]
  transportAssignments   StudentTransportAssignment[]
  markAuditLogs          MarkAuditLog[]

  @@index([gradeId])
  @@index([sectionId])
  @@index([streamId])
  @@index([status])
  @@index([fullName])
  @@index([gradeId, sectionId, status])
}

model StudentAcademicYearRecord {
  id             String       @id @default(uuid())
  studentId      String
  academicYearId String
  gradeId        String
  sectionId      String
  streamId       String?
  status         String       @default("ACTIVE")
  enrolledAt     DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade        Grade        @relation(fields: [gradeId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  stream       Stream?      @relation(fields: [streamId], references: [id])
  attendance   Attendance[]
  disciplines  StudentDiscipline[]

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([studentId])
  @@index([gradeId, sectionId])
  @@index([status])
  @@index([academicYearId, status, gradeId, sectionId])
  @@map("student_academic_year_records")
}

model StudentPromotion {
  id               String   @id @default(uuid())
  studentId        String
  academicYear     String
  fromGradeId      String
  fromSectionId    String
  toGradeId        String?
  toSectionId      String?
  fromStreamId     String?
  toStreamId       String?
  promotedByUserId String
  promotedAt       DateTime @default(now())
  notes            String?
  fromGrade        Grade    @relation("FromGrade", fields: [fromGradeId], references: [id])
  fromSection      Section  @relation("FromSection", fields: [fromSectionId], references: [id])
  fromStream       Stream?  @relation("FromStream", fields: [fromStreamId], references: [id])
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  toGrade          Grade?   @relation("ToGrade", fields: [toGradeId], references: [id])
  toSection        Section? @relation("ToSection", fields: [toSectionId], references: [id])
  toStream         Stream?  @relation("ToStream", fields: [toStreamId], references: [id])

  @@index([studentId])
  @@index([fromGradeId])
  @@index([toGradeId])
}

model Attendance {
  id                   String                     @id @default(uuid())
  studentId            String
  academicYearId       String?
  academicYearRecordId String?
  date                 DateTime                   @default(now())
  status               String
  session              String?
  remarks              String?
  latitude             Float?
  longitude            Float?
  locationVerified     Boolean?                   @default(false)
  locationDistance     Float?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  teacherId            String?
  student              Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher              Teacher?                   @relation(fields: [teacherId], references: [id])
  academicYear         AcademicYear?              @relation(fields: [academicYearId], references: [id])
  academicYearRecord   StudentAcademicYearRecord? @relation(fields: [academicYearRecordId], references: [id])

  @@unique([studentId, date, session])
  @@index([studentId])
  @@index([academicYearId])
  @@index([academicYearRecordId])
  @@index([date])
  @@index([session])
  @@index([status])
  @@index([date, status])
  @@index([academicYearId, date])
  @@index([teacherId, date])
  @@index([studentId, date])
}

model AttendanceEditRequest {
  id          String    @id @default(uuid())
  teacherId   String
  studentId   String?
  gradeId     String?
  sectionId   String?
  date        DateTime
  session     String?
  reason      String?
  status      String    @default("PENDING")
  adminNote   String?
  processedBy String?
  processedAt DateTime?
  isUsed      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([status])
  @@index([date])
  @@map("attendance_edit_requests")
}

model AuditLog {
  id          String   @id @default(uuid())
  user_id     String?
  action      String
  entity_type String
  entity_id   String?
  old_values  Json?
  new_values  Json?
  created_at  DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([created_at])
  @@index([user_id])
  @@map("audit_logs")
}

model AttendanceReport {
  id                    String   @id @default(uuid())
  student_id            String
  class_id              String
  month                 Int
  year                  Int
  total_days            Int      @default(0)
  present_days          Int      @default(0)
  absent_days           Int      @default(0)
  late_days             Int      @default(0)
  leave_days            Int      @default(0)
  attendance_percentage Decimal  @default(0.00) @db.Decimal(5, 2)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([student_id, month, year])
  @@map("attendance_reports")
}

model ParentStudentLink {
  id               String   @id @default(uuid())
  parentId         String
  studentId        String
  relationshipType String?  @default("Guardian")
  createdAt        DateTime @default(now())
  parent           User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
}

model ParentNotification {
  id             String   @id @default(uuid())
  studentId      String?
  type           String
  category       String   @default("GENERAL")
  priority       String   @default("NORMAL")
  title          String
  message        String
  targetRole     String?
  targetAudience String?  @default("GENERAL")
  metadata       String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  student        Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
  @@index([targetAudience])
  @@index([studentId, createdAt])
  @@index([isRead])
}

model ParentPreferences {
  id                 String   @id @default(uuid())
  parentPhone        String   @unique
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  pushNotifications  Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model Conversation {
  id               String               @id @default(uuid())
  name             String?
  isGroup          Boolean              @default(false)
  avatar           String?
  description      String?
  groupType        String?
  isAnnouncement   Boolean              @default(false)
  isSavedMessages  Boolean              @default(false)
  savedMessagesFor String?              @unique
  createdBy        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  members          ConversationMember[]
  messages         Message[]
  pinnedMessages   PinnedMessage[]
  savedBookmarks   SavedBookmark[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER")
  isMuted        Boolean      @default(false)
  mutedUntil     DateTime?
  lastSeenAt     DateTime?
  nickname       String?
  joinedAt       DateTime     @default(now())
  clearedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@index([userId, conversationId])
}

model Message {
  id              String            @id @default(uuid())
  conversationId  String
  senderId        String
  content         String?
  type            String            @default("TEXT")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  editedAt        DateTime?
  isDeleted       Boolean           @default(false)
  replyToId       String?
  forwardedFromId String?
  attachments     Json?
  metadata        Json?
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo         Message?          @relation("Replies", fields: [replyToId], references: [id])
  replies         Message[]         @relation("Replies")
  sender          User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions       MessageReaction[]
  readBy          MessageRead[]
  pinnedIn        PinnedMessage[]
  savedBookmarks  SavedBookmark[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@index([createdAt])
}

model PinnedMessage {
  id             String       @id @default(uuid())
  conversationId String
  messageId      String
  pinnedBy       String
  pinnedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
  @@index([conversationId])
}

model SavedBookmark {
  id             String       @id @default(uuid())
  userId         String
  messageId      String
  conversationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, conversationId])
  @@index([userId])
  @@map("saved_bookmarks")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model CallSession {
  id               String            @id @default(uuid())
  callId           String?           @unique
  conversationId   String?
  type             String            @default("VOICE")
  status           String            @default("ONGOING")
  startTime        DateTime          @default(now())
  answerTime       DateTime?
  endTime          DateTime?
  duration         Int?
  disconnectReason String?
  networkQuality   String?
  createdAt        DateTime          @default(now())
  history          CallHistory[]
  participants     CallParticipant[]

  @@index([callId])
}

model CallParticipant {
  id            String      @id @default(uuid())
  callSessionId String
  userId        String
  joinedAt      DateTime    @default(now())
  leftAt        DateTime?
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callSessionId, userId])
}

model CallHistory {
  id               String      @id @default(uuid())
  callId           String?
  userId           String
  recipientId      String?
  callSessionId    String
  type             String
  status           String
  duration         Int?
  answerTime       DateTime?
  endTime          DateTime?
  disconnectReason String?
  createdAt        DateTime    @default(now())
  callSession      CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([callId])
}

model PendingRegistration {
  id            String   @id
  email         String   @unique
  password_hash String
  full_name     String
  role          String
  phone         String?
  school_name   String?
  token         String   @unique
  expires_at    DateTime
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([token])
}

model PlatformConfig {
  id               String   @id @default("singleton")
  platformName     String   @default("Addis Hiwot")
  supportEmail     String   @default("support@addishiwot.edu.et")
  maintenanceMode  Boolean  @default(false)
  autoBackup       Boolean  @default(true)
  apiRateLimit     Int      @default(1000)
  maxUploadSize    Int      @default(50)
  trialEnabled     Boolean  @default(true)
  trialDuration    Int      @default(14)
  trialCapacity    Int      @default(100)
  updatedAt        DateTime @updatedAt
  maxLoginAttempts Int      @default(5)
  sessionTimeout   Int      @default(30)
  twoFactorEnabled Boolean  @default(false)

  @@map("platform_configs")
}

model SupportTicket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique
  authorId     String?
  subject      String
  description  String
  category     String   @default("General")
  status       String   @default("open")
  priority     String   @default("normal")
  assignee     String?
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@map("support_tickets")
}

model BroadcastLog {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   @default("info")
  sentCount Int      @default(0)
  sentAt    DateTime @default(now())

  @@map("broadcast_logs")
}

model SystemRole {
  id          String   @id @default(uuid())
  key         String
  name        String
  description String?
  color       String   @default("#6366f1")
  isSystem    Boolean  @default(true)
  isActive    Boolean  @default(true)
  permissions Json     @default("{}")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("system_roles")
}

model UserNotification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  category   String   @default("GENERAL")
  priority   String   @default("NORMAL")
  title      String
  message    String
  targetRole String?
  metadata   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model DisciplineCategory {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  isDefault   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  disciplines StudentDiscipline[]

  @@map("discipline_categories")
}

model StudentDiscipline {
  id                         String                     @id @default(uuid())
  caseNumber                 String?
  studentId                  String
  academicYearId             String?
  academicYearRecordId       String?
  gradeId                    String
  sectionId                  String
  streamId                   String?
  date                       DateTime                   @default(now())
  time                       String?
  categoryId                 String?
  categoryName               String
  severity                   String                     @default("LOW")
  title                      String
