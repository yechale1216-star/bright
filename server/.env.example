# =============================================================================
# Addis Hiwot — Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env with real credentials to source control.
# =============================================================================

# Server
PORT=5000

# Frontend URL — used for password-reset email links.
# Must be your real web/app URL (not localhost) so links work on mobile clients.
FRONTEND_URL=https://your-app-domain.com

# Application URL — used for internal callbacks (e.g. email confirmation links).
APP_URL=https://your-backend-domain.com

# Comma-separated list of additional allowed CORS origins (optional).
# ALLOWED_ORIGINS=https://extra-domain.com,https://other-domain.com

# =============================================================================
# Database (Supabase / PostgreSQL via Prisma)
# =============================================================================
# Pooled connection (used by Prisma at runtime via PgBouncer).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Direct connection (used by Prisma for migrations).
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# =============================================================================
# Authentication
# =============================================================================
# JWT signing secret — use a long, random string (minimum 32 characters).
JWT_SECRET=replace-with-a-long-random-secret-string

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# Redis (Upstash — used for Socket.io multi-instance broadcasting)
# =============================================================================
REDIS_URL=rediss://default:PASSWORD@your-redis-host:6379

# =============================================================================
# Email — Resend (primary email provider)
# =============================================================================
RESEND_API_KEY=re_your_resend_api_key

# =============================================================================
# Firebase Admin SDK (push notifications)
# =============================================================================
# Paste the full JSON content of your Firebase service account key file.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}'
